# Jarvis — variables d'environnement (toutes OPTIONNELLES)
#
# Aucune clé API n'est requise : le TTS tourne 100% en local via Kokoro ONNX.
# (L'ancienne ELEVENLABS_API_KEY a été retirée : elle n'était lue nulle part.)
#
# Jarvis fonctionne sans .env. Copiez ce fichier en .env uniquement si vous
# voulez surcharger un de ces réglages :  cp .env.example .env

# Active l'UI native Swift "Vibe Island" (0 = off par défaut, 1 = on).
# start.sh force déjà JARVIS_UI=1.
# JARVIS_UI=1

# Modèle Claude Code utilisé par le backend.
# JARVIS_MODEL=claude-haiku-4-5

# Voix Kokoro (ff_siwis = FR optimal ; am_michael / bm_george = autres).
# JARVIS_KOKORO_VOICE=ff_siwis

# Vitesse de la voix Kokoro.
# JARVIS_KOKORO_SPEED=1.0

# Chemin du fichier de log (déf /tmp/jarvis.log) et désactivation des couleurs.
# JARVIS_LOG=/tmp/jarvis.log
# JARVIS_NO_COLOR=1
